# ===== Virtual Environments =====
.venv/
venv/
env/
ENV/

# ===== Python Bytecode & Cache =====
__pycache__/
*.py[cod]
*$py.class
*.so

# ===== Packaging / Build Artifacts =====
build/
dist/
*.egg-info/
.eggs/

# ===== uv Specific =====
# Keep uv.lock (it IS committed), but ignore its cache
.uv/
uv.lock.orig

# ===== Jupyter Notebooks =====
.ipynb_checkpoints/
*.ipynb_checkpoints

# ===== Environment Variables & Secrets (CRITICAL for GenAI) =====
.env
.env.*
!.env.example
*.key
secrets/
credentials.json
service-account.json

# ===== Testing / Coverage =====
.pytest_cache/
.coverage
htmlcov/
.tox/

# ===== Type Checking & Linting Caches =====
.mypy_cache/
.ruff_cache/
.pyre/

# ===== IDE / Editor =====
.vscode/
.idea/
*.swp

# ===== OS Files =====
.DS_Store
Thumbs.db

# ===== Logs & Data (optional, based on your project) =====
*.log
data/
raw_data/
*.sqlite
*.db

# ===== Model Weights / Large Files (if you download models) =====
*.bin
*.safetensors
*.pt
*.pth
*.onnx
models/
cache/